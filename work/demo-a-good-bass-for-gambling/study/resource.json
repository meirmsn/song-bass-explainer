  "cards": {
    "intro": [
      {
        "label": "Pocket",
        "body": "Kit and bass are barely in \u2014 the first downbeat is almost empty air before the groove clicks."
      },
      {
        "label": "Figure",
        "body": "Treat bar 0 as a count-off: leave the low E unspoken, then land the E\u2013B\u2013E\u2013Bb pickup into Groove A."
      },
      {
        "label": "Harmony",
        "body": "Em center (i). Nothing to outline yet \u2014 the ear waits for the tonic pedal."
      },
      {
        "label": "Missable",
        "body": "Don\u2019t fill the open. The gambling swagger starts when the chromatic Bb answers the E, not before."
      }
    ],
    "a1": [
      {
        "label": "Pocket",
        "body": "~123 BPM 4/4. Drums sit medium-tight; bass speaks on the beat with little push \u2014 pocket is square and confident."
      },
      {
        "label": "Figure",
        "body": "Core figure: E on beats 1 & 3, B (or Bb neighbor) answering. Hear E\u2013B\u2013E\u2013Bb as tonic with a chromatic upper-neighbor tease."
      },
      {
        "label": "Harmony",
        "body": "Em / Em7 home. Occasional A7 or Am color when the bass hangs on A/Bb \u2014 keep chord quality (7 vs triad) when you hear the flat-7."
      },
      {
        "label": "Missable",
        "body": "The Bb is a chromatic neighbor, not a key change. Don\u2019t re-root the bar on Bb; it ornaments E."
      }
    ],
    "verse": [
      {
        "label": "Pocket",
        "body": "Back to medium drum weight. Bass leans harder on Bb hangs before resolving to E."
      },
      {
        "label": "Figure",
        "body": "Bb\u2013Bb\u2013Bb\u2013A into A\u2013E\u2013B\u2013E. Chromatic hang, then a clean Em outline."
      },
      {
        "label": "Harmony",
        "body": "Em answered by Am (iv) and A7 colors. Keep Am vs Am7 / A7 quality from the template when the 7th is clear."
      },
      {
        "label": "Missable",
        "body": "The long Bb is a delay of tonic, not a new tonal center \u2014 resolve it to E on purpose."
      }
    ],
    "a2": [
      {
        "label": "Pocket",
        "body": "Same pocket as A \u2014 hats/kick keep the gambling pulse; bass stays on the grid."
      },
      {
        "label": "Figure",
        "body": "E pedal with Bb\u2013A walkbacks. Lock the octave: low E, then the neighbor cluster above."
      },
      {
        "label": "Harmony",
        "body": "Still Em-centric. When chroma leans Am/A7, it\u2019s iv / V-of-iv flavor over the same bass story."
      },
      {
        "label": "Missable",
        "body": "Mute the bass (S/M) and check: the \u2018C7\u2019 mirage is often just Bb in the bass against Em."
      }
    ],
    "b1": [
      {
        "label": "Pocket",
        "body": "Drum energy lifts (~bars 17\u201325). Ride the denser kit without rushing the E pedals."
      },
      {
        "label": "Figure",
        "body": "More E repeats per bar (E\u2013E\u2013E\u2013x) \u2014 a lift pedal \u2014 then Gb/F chromatic crumbs as tension."
      },
      {
        "label": "Harmony",
        "body": "Em / Em7 with brief E major color flashes. Preserve Em7 when the flat-7 is audible."
      },
      {
        "label": "Missable",
        "body": "The lift is density, not a new key. Keep E as gravity; Gb is passing, not a modulation."
      }
    ],
    "chorus": [
      {
        "label": "Pocket",
        "body": "Build densifies again; stay behind the beat slightly so the walk doesn\u2019t get stiff."
      },
      {
        "label": "Figure",
        "body": "Walk fragments (G\u2013Gb\u2013F, F\u2013E\u2026) into E pedals \u2014 approach notes into tonic."
      },
      {
        "label": "Harmony",
        "body": "Em with B7 (V) approaches. Prefer B7 over vague diminished labels when the leading tone resolves to E."
      },
      {
        "label": "Missable",
        "body": "Walk tones are approach notes \u2014 name the target chord (Em), not every passing PC."
      }
    ],
    "br": [
      {
        "label": "Pocket",
        "body": "Bar 26 drums duck \u2014 a one-bar breath \u2014 then the kit returns. Feel the drop as intentional air."
      },
      {
        "label": "Figure",
        "body": "E figures continue through the drop; don\u2019t stop the bass just because the kit thins."
      },
      {
        "label": "Harmony",
        "body": "Em pedal through the drop. Use the thin bar to hear bass alone against residual harmony."
      },
      {
        "label": "Missable",
        "body": "Phone tip: loop the drop bar and toggle D&B vs full \u2014 the pocket hole is the lesson."
      }
    ],
